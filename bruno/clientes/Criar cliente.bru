meta {
  name: Criar cliente
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/clientes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nome": "Maria Silva",
    "cep": "66000000"
  }
}

assert {
  res.status: eq 201
  res.body.nome: eq "Maria Silva"
}
